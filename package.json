{
  "name": "meat",
  "version": "2.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "postinstall": "npm install --prefix backend --no-fund --no-audit",
    "start": "ng serve",
    "api": "npm --prefix backend run dev",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:api": "npm --prefix backend test",
    "e2e": "ng build && start-server-and-test e2e:serve http://localhost:4300/api/restaurants cy:run",
    "e2e:open": "ng build && start-server-and-test e2e:serve http://localhost:4300/api/restaurants cy:open",
    "e2e:serve": "node cypress/e2e-server.mts",
    "cy:run": "node cypress/run-cypress.mjs run",
    "cy:open": "node cypress/run-cypress.mjs open",
    "serve:prod": "npm run build && npm --prefix backend start"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "cypress": "^16.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.13",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
